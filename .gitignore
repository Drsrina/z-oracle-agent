# ==============================================================
# Z-Oracle Atendee — .gitignore
# ==============================================================

# Variáveis de ambiente e segredos (NUNCA commitar chaves reais)
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
secrets.*
credentials.json
client_secret*.json

# Ambiente virtual Python
.venv/
venv/
env/

# Dependências Node.js (Frontend)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Cache do modelo RAG e LlamaIndex
index_cache*/
.cache/

# Cache Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Logs e arquivos temporários
*.log
*.tmp

# Arquivos de planilhas e dados locais
*.xlsx
*.xls
*.csv
*.sql
!docker/**/*.sql

# IDEs e Sistema Operacional
.vscode/settings.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Docker builds e volumes locais
*.tar
docker-data/
postgres_data/
redis_data/
