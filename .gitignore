# ==============================================================
# Z-Oracle Agent — .gitignore
# ==============================================================

# Variáveis de ambiente (NUNCA commitar chaves reais)
.env
.env.*
!.env.example

# Ambiente virtual Python
.venv/
venv/
env/

# Dependências Node.js (Frontend)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Cache do modelo RAG e LlamaIndex
index_cache*/
.cache/

# Cache Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Logs e arquivos temporários
*.log
*.tmp

# Arquivos de planilhas e dados locais
*.xlsx
*.xls
*.csv
*.sql
!docker/**/*.sql

# IDEs e Sistema Operacional
.vscode/settings.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Docker builds locais
*.tar
