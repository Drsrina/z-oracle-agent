# ==============================================================
# Z-Oracle Agent — Template de Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais
# O .env NUNCA deve ser commitado no Git
# ==============================================================

# --------------------------------------------------
# LLM Principal (Google Gemini)
# Obter em: https://aistudio.google.com/apikey
# --------------------------------------------------
GEMINI_API_KEY=sua_chave_google_ai_studio_aqui

# --------------------------------------------------
# Redis — Sessões de Conversa (Upstash em produção)
# FORMATO TCP (não REST): rediss://default:SENHA@HOST.upstash.io:6379
# Obter em: https://console.upstash.com > Redis > Connect > .env
# Em desenvolvimento local: redis://localhost:6379/0
# --------------------------------------------------
REDIS_URL=rediss://default:SUA_SENHA@seu-host.upstash.io:6379

# --------------------------------------------------
# Supabase — Logger Analítico
# Obter em: https://supabase.com/dashboard > Seu Projeto > Settings > API
# --------------------------------------------------
SUPABASE_URL=https://seu-project-id.supabase.co
SUPABASE_ANON_KEY=seu_anon_key_jwt_aqui
