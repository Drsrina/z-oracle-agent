# ==============================================================
# Z-Oracle Atendee — Template de Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais
# O .env NUNCA deve ser commitado no Git
# ==============================================================

# --------------------------------------------------
# LLM Principal (Google Gemini) — Obrigatório
# Obter em: https://aistudio.google.com/apikey
# --------------------------------------------------
GEMINI_API_KEY=sua_chave_google_ai_studio_aqui

# --------------------------------------------------
# Redis — Sessões de Conversa
# Local (Docker Compose): redis://redis_db:6379/0
# Local (Standalone):     redis://localhost:6379/0
# Nuvem (Upstash TCP):    rediss://default:SUA_SENHA@seu-host.upstash.io:6379
# --------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --------------------------------------------------
# PostgreSQL (Substitui Supabase) — Recomendado Self-Hosted
# Suporta pgvector para RAG e tabelas analíticas sessoes/mensagens/logs
# Local (Docker Compose): postgresql://postgres:postgres@postgres_db:5432/zoracle
# Local (Standalone):     postgresql://postgres:postgres@localhost:5432/zoracle
# --------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zoracle

# --------------------------------------------------
# Supabase — Opcional / Legado
# Deixe em branco se estiver utilizando PostgreSQL nativo
# --------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
